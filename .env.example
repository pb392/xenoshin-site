# Copy to .env on the server only. Never commit .env.
# Paste your key from https://aistudio.google.com/apikey after the = sign.
GEMINI_API_KEY=
# Filled in automatically by deploy/setup.sh (random value).
ADMIN_TOKEN=
# Optional overrides
EMBED_MODEL=gemini-embedding-2
EMBED_DIMS=768
GEN_MODEL=gemini-3.5-flash-lite
RATE_PER_IP_PER_MINUTE=8
RATE_GLOBAL_PER_DAY=300
